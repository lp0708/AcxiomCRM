@model List<FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
    string? current = ViewBag.View;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Follow-Ups</h2>
    <a asp-action="Create" class="btn btn-primary">Schedule Follow-Up</a>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(current == "pending" ? "active" : "")" asp-action="Index" asp-route-view="pending">Pending</a></li>
    <li class="nav-item"><a class="nav-link @(current == "overdue" ? "active" : "")" asp-action="Index" asp-route-view="overdue">Overdue</a></li>
    <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(current) ? "active" : "")" asp-action="Index">All</a></li>
</ul>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="view" value="@current" />
    <div class="col-md-3">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Customer or lead name" aria-label="Related customer or lead" />
    </div>
    <div class="col-md-2">
        <input name="date" type="date" value="@ViewBag.Date" class="form-control" aria-label="Date" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<FollowUpStatus>(), (object?)ViewBag.Status?.ToString()))" aria-label="Status">
            <option value="">All statuses</option>
        </select>
    </div>
    @if (!User.IsSalesOnly())
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" asp-items="@(new SelectList(((SelectList)ViewBag.Assignees).Items, "Id", "UserName", (object?)ViewBag.AssignedTo))" aria-label="Assigned user">
                <option value="">All users</option>
            </select>
        </div>
    }
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Date</th><th>Related To</th><th>Type</th><th>Status</th><th>Remarks</th><th>Assigned To</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr class="@(f.IsOverdue ? "table-danger" : "")">
                <td>@f.FollowUpDate.ToString("dd MMM yyyy") @if (f.IsOverdue) { <span class="badge bg-danger">Overdue</span> }</td>
                <td>
                    @if (f.Customer != null) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId">@f.Customer.CustomerName</a> }
                    @if (f.Lead != null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId">@f.Lead.LeadName</a> <small class="text-muted">(lead)</small> }
                </td>
                <td>@f.FollowUpType</td>
                <td>@f.Status</td>
                <td>@f.Remarks</td>
                <td>@f.AssignedUser?.UserName</td>
                <td class="text-nowrap">
                    @if (f.Status == FollowUpStatus.Planned)
                    {
                        <form asp-action="SetStatus" asp-route-id="@f.Id" method="post" class="d-inline">
                            <input type="hidden" name="status" value="Completed" />
                            <button class="btn btn-sm btn-success">Complete</button>
                        </form>
                        <form asp-action="SetStatus" asp-route-id="@f.Id" method="post" class="d-inline">
                            <input type="hidden" name="status" value="Missed" />
                            <button class="btn btn-sm btn-outline-warning">Missed</button>
                        </form>
                    }
                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <partial name="_DeleteButton" model='("FollowUps", f.Id)' />
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">No follow-ups found.</td></tr>
        }
    </tbody>
</table>
