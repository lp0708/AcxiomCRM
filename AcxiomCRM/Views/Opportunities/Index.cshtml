@model List<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Opportunities</h2>
    <a asp-action="Create" class="btn btn-primary">New Opportunity</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name or customer" aria-label="Search" />
    </div>
    <div class="col-md-3">
        <select name="stage" class="form-select" asp-items="@(new SelectList(Enum.GetNames<OpportunityStage>(), (object?)ViewBag.Stage?.ToString()))" aria-label="Stage">
            <option value="">All stages</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="@(new SelectList(new[] { "Open", "Won", "Lost" }, (object?)ViewBag.StatusFilter))" aria-label="Status">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Search</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Name</th><th>Customer</th><th>Stage</th><th>Status</th><th class="text-end">Amount</th><th class="text-end">Probability</th><th class="text-end">Weighted</th><th>Expected Close</th><th>Assigned To</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@o.Id">@o.OpportunityName</a></td>
                <td>@o.Customer?.CustomerName</td>
                <td>@o.Stage</td>
                <td>@o.Status</td>
                <td class="text-end">@o.Amount.ToString("N2")</td>
                <td class="text-end">@o.Probability%</td>
                <td class="text-end">@o.WeightedAmount.ToString("N2")</td>
                <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                <td>@o.AssignedUser?.UserName</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <partial name="_DeleteButton" model='("Opportunities", o.Id)' />
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="10" class="text-center text-muted">No opportunities found.</td></tr>
        }
    </tbody>
</table>
