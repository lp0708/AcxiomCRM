@model OpportunityFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Opportunity" : "Edit Opportunity";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="OpportunityName" class="form-label"></label>
            <input asp-for="OpportunityName" class="form-control" />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CustomerId" class="form-label"></label>
            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                <option value="0">-- Select Customer --</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Probability" class="form-label"></label>
            <input asp-for="Probability" class="form-control" type="number" />
            <span asp-validation-for="Probability" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Stage" class="form-label"></label>
            <select asp-for="Stage" asp-items="@(new SelectList(Enum.GetNames<OpportunityStage>()))" class="form-select"></select>
            <span asp-validation-for="Stage" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="ExpectedCloseDate" class="form-label"></label>
            <input asp-for="ExpectedCloseDate" class="form-control" />
            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
        </div>
        <partial name="_AssignedToField" model="Model" />
        <div class="col-md-12 mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
