@model Opportunity
@{
    ViewData["Title"] = Model.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.OpportunityName <span class="badge bg-info text-dark">@Model.Stage</span></h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <partial name="_DeleteButton" model='("Opportunities", Model.Id)' />
    </div>
</div>

<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-4"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.CustomerName</a></dd>
    <dt class="col-sm-2">Source Lead</dt>
    <dd class="col-sm-4">
        @if (Model.Lead != null)
        {
            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a>
        }
    </dd>
    <dt class="col-sm-2">Amount</dt><dd class="col-sm-4">@Model.Amount.ToString("N2")</dd>
    <dt class="col-sm-2">Probability</dt><dd class="col-sm-4">@Model.Probability%</dd>
    <dt class="col-sm-2">Weighted Amount</dt><dd class="col-sm-4">@Model.WeightedAmount.ToString("N2")</dd>
    <dt class="col-sm-2">Status</dt><dd class="col-sm-4">@Model.Status</dd>
    <dt class="col-sm-2">Expected Close</dt><dd class="col-sm-4">@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-2">Assigned To</dt><dd class="col-sm-4">@Model.AssignedUser?.UserName</dd>
    <dt class="col-sm-2">Created</dt><dd class="col-sm-4">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
    <dt class="col-sm-2">Notes</dt><dd class="col-sm-4">@Model.Notes</dd>
</dl>
