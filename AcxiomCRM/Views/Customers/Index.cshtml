@model List<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Customers</h2>
    <a asp-action="Create" class="btn btn-primary">New Customer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name, email, phone or company" aria-label="Search" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<CustomerStatus>(), (object?)ViewBag.Status?.ToString()))" aria-label="Status">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Search</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th>Assigned To</th><th>Created</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CustomerCode</td>
                <td><a asp-action="Details" asp-route-id="@c.Id">@c.CustomerName</a></td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>@c.CompanyName</td>
                <td><span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                <td>@c.AssignedUser?.UserName</td>
                <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <partial name="_DeleteButton" model='("Customers", c.Id)' />
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">No customers found.</td></tr>
        }
    </tbody>
</table>
