@model List<Activity>
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Activities</h2>
    <a asp-action="Create" class="btn btn-primary">Log Activity</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="type" class="form-select" asp-items="@(new SelectList(Enum.GetNames<ActivityType>(), (object?)ViewBag.Type?.ToString()))" aria-label="Type">
            <option value="">All types</option>
        </select>
    </div>
    <div class="col-md-2">
        <input name="date" type="date" value="@ViewBag.Date" class="form-control" aria-label="Date" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<ActivityStatus>(), (object?)ViewBag.Status?.ToString()))" aria-label="Status">
            <option value="">All statuses</option>
        </select>
    </div>
    @if (!User.IsSalesOnly())
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" asp-items="@(new SelectList(((SelectList)ViewBag.Assignees).Items, "Id", "UserName", (object?)ViewBag.AssignedTo))" aria-label="Assigned user">
                <option value="">All users</option>
            </select>
        </div>
    }
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Date</th><th>Type</th><th>Subject</th><th>Related To</th><th>Status</th><th>Assigned To</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.ActivityDate.ToString("dd MMM yyyy")</td>
                <td>@a.ActivityType</td>
                <td>@a.Subject</td>
                <td>@(a.Customer?.CustomerName ?? a.Lead?.LeadName)</td>
                <td>@a.Status</td>
                <td>@a.AssignedUser?.UserName</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <partial name="_DeleteButton" model='("Activities", a.Id)' />
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">No activities found.</td></tr>
        }
    </tbody>
</table>
