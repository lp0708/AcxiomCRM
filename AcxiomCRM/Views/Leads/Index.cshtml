@model List<Lead>
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Leads</h2>
    <a asp-action="Create" class="btn btn-primary">New Lead</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name or company" aria-label="Search" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<LeadStatus>(), (object?)ViewBag.Status?.ToString()))" aria-label="Status">
            <option value="">All statuses</option>
        </select>
    </div>
    @if (!User.IsSalesOnly())
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" asp-items="@(new SelectList(((SelectList)ViewBag.Assignees).Items, "Id", "UserName", (object?)ViewBag.AssignedTo))" aria-label="Assigned user">
                <option value="">All users</option>
            </select>
        </div>
    }
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Search</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Code</th><th>Name</th><th>Company</th><th>Source</th><th>Status</th><th>Priority</th><th>Expected Value</th><th>Assigned To</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.LeadCode</td>
                <td><a asp-action="Details" asp-route-id="@l.Id">@l.LeadName</a></td>
                <td>@l.CompanyName</td>
                <td>@l.Source</td>
                <td><span class="badge bg-info text-dark">@l.Status</span></td>
                <td>@l.Priority</td>
                <td>@l.ExpectedValue.ToString("N2")</td>
                <td>@l.AssignedUser?.UserName</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <partial name="_DeleteButton" model='("Leads", l.Id)' />
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">No leads found.</td></tr>
        }
    </tbody>
</table>
